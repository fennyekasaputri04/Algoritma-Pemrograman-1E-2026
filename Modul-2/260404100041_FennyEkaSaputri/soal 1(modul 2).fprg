<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="soal 2(modul 2)"/>
        <attribute name="authors" value="FENNY EKA SAPUTRI"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 08:42:33 PM"/>
        <attribute name="created" value="RkVOTlkgRUtBIFNBUFVUUkk7TEFQVE9QLTRWMzJEVEpEOzIwMjYtMTAtMDc7MDY6MDk6MjYgUE07MzUzNg=="/>
        <attribute name="edited" value="RkVOTlkgRUtBIFNBUFVUUkk7TEFQVE9QLTRWMzJEVEpEOzIwMjYtMTAtMDc7MDg6NDI6MzMgUE07MTszNjQx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kode, digit1, digit2, digit3, pelacak" type="Integer" array="False" size=""/>
            <output expression="&quot;masukkan kode 3 digit&quot;" newline="True"/>
            <input variable="kode"/>
            <assign variable="digit1" expression="kode/100"/>
            <assign variable="digit2" expression="(kode/10) Mod 10"/>
            <assign variable="digit3" expression="kode Mod 10"/>
            <assign variable="pelacak" expression="digit1 * digit3"/>
            <output expression="&quot;Digit: &quot; &amp; digit1 &amp; &quot;, &quot; &amp; digit2 &amp; &quot;, &quot; &amp; digit3 &amp; &quot; | Pelacak awal: &quot; &amp; pelacak" newline="True"/>
            <if expression="digit2 % 2 = 0">
                <then>
                    <assign variable="pelacak" expression="pelacak + 25"/>
                </then>
                <else>
                    <assign variable="pelacak" expression="pelacak - digit2"/>
                </else>
            </if>
            <output expression="&quot;Setelah tahap 1: &quot; &amp; pelacak" newline="True"/>
            <if expression="pelacak % 3 = 0">
                <then>
                    <assign variable="pelacak" expression="pelacak / 3"/>
                </then>
                <else>
                    <assign variable="pelacak" expression="pelacak * 2"/>
                </else>
            </if>
            <output expression="&quot;Pelacak akhir: &quot; &amp; pelacak" newline="True"/>
            <if expression="pelacak &gt; 50">
                <then>
                    <output expression="&quot;Kategori A&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="pelacak &gt; 20">
                        <then>
                            <output expression="&quot;Kategori B&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Password Ditolak&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="pelacak % 2 = 0">
                <then>
                    <output expression="&quot;siklus genap&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;siklus ganjil&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
